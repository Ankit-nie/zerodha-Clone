# TradeX Docker Compose Environment Variables
# Copy this file to .env and customize for local or production use.

MONGO_URL=mongodb://mongo:27017/tradex
TOKEN_KEY=change-this-to-a-strong-jwt-secret

# Optional Email Alerts (Gmail SMTP or Brevo HTTPS API)
EMAIL_USER=
EMAIL_PASS=
BREVO_API_KEY=

# Allowed browser origins for Backend CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
